# MCP toggles) and must not be shared.
.claude/settings.local.json
.claude/*.local.json

# Playwright (browser binaries live outside the repo; these are run artifacts)
test-results/
playwright-report/
blob-report/
.playwright/

# Misc
*.local
.cache/
tmp/
uploads/
