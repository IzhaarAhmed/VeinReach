# Root env for docker compose. Copy to .env and edit before deploying.
# `docker compose` auto-loads this file and substitutes the ${VARS} in docker-compose.yml.

# Origin the browser uses to reach the frontend (compose maps it to :8080).
CLIENT_URL=http://localhost:8080

# Refresh cookie Secure flag. Keep false for local HTTP; set true behind HTTPS.
COOKIE_SECURE=false

# JWT secrets — generate strong values, e.g. `openssl rand -hex 64`.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
