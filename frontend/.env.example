# Base URL of the VeinReach backend API
VITE_API_URL=http://localhost:5000/api/v1
# Socket.io server origin
VITE_SOCKET_URL=http://localhost:5000

# ─── Firebase web push (OPTIONAL — push silently disabled if unset) ─────
# These are the PUBLIC web-app values from Firebase console
# (Project settings → General → Your apps), NOT the Admin SDK key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web configuration → Generate key pair
VITE_FIREBASE_VAPID_KEY=
