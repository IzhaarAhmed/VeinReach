# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins for CORS
CLIENT_URL=http://localhost:3000
# Refresh cookie Secure flag. Leave blank to follow NODE_ENV (true in prod).
# Force false when serving over plain HTTP (e.g. local Docker on :8080).
COOKIE_SECURE=

# ─── Database (REQUIRED) ────────────────────────────────
# Local: mongodb://127.0.0.1:27017/veinreach
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/veinreach?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/veinreach

# ─── First admin (bootstrap) ────────────────────────────
# Comma-separated addresses promoted to `admin` on every startup.
#
# PROMOTE-ONLY: each account must already be registered through the app. This
# never creates a user, so no admin password ever lives in this file. On a
# fresh deployment: register the address in the UI, set it here, restart.
#
# Idempotent and non-destructive — it never demotes, so leaving it set cannot
# lock you out. Suspended accounts are refused.
#
# Equivalent one-off command:  npm run admin:grant -- you@example.com
ADMIN_EMAILS=

# ─── JWT (REQUIRED) ─────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── Redis (OPTIONAL — degrades gracefully if unset) ────
# Local: redis://127.0.0.1:6379
REDIS_URL=

# ─── Cloudflare R2 (OPTIONAL — file storage; disabled/dev-fallback if unset) ─
# Stores profile images, verification/hospital documents, chat attachments,
# and donation certificates. Requires all of ACCOUNT_ID/KEYs/BUCKET to activate.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (custom domain or r2.dev). Needed for public
# assets like profile images + certificates; private docs use presigned URLs.
R2_PUBLIC_URL=
# Max upload size clients may request a presigned URL for, and presign TTL (sec).
UPLOAD_MAX_MB=10
UPLOAD_PRESIGN_TTL_SEC=300

# ─── SMS / Mobile OTP (OPTIONAL — codes logged instead of sent if unset) ──
# provider: '' disables real sending (dev), 'twilio' uses the Twilio REST API.
# Twilio also requires `npm i twilio` (kept opt-in).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
OTP_LENGTH=6
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ─── Email / Nodemailer (OPTIONAL — logged instead of sent if unset) ──────
# Used for email verification links and urgent/critical request alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VeinReach <no-reply@veinreach.app>"

# ─── Firebase Cloud Messaging (OPTIONAL — push disabled if unset) ─
# Paste the service-account JSON as a single-line string, or a path to the file.
# Also requires `npm i firebase-admin` (kept opt-in — it's a heavy dependency).
FCM_SERVICE_ACCOUNT=

# ─── Privacy: grievance contact ─────────────────────────
# Published in the privacy policy as the Grievance Officer address (DPDP §13).
# Set the SPA's VITE_PRIVACY_CONTACT to the same address — that one is what the
# policy page renders; this one is for mail the server sends.
PRIVACY_CONTACT=

# ─── Data retention (tunable; enforced by the retention worker) ─────────────
# Days to keep each category. 0 or less disables that category. Defaults are
# deliberately short. Donations are absent on purpose: they are the donation
# ledger, retained indefinitely and anonymized (never deleted) when an account
# is closed, so recipients and hospitals keep their own records.
#
# These numbers are stated in the published privacy policy — changing one
# changes a promise, so update frontend/src/content/privacyPolicy.js too.
RETENTION_ENABLED=true
RETENTION_MESSAGES_DAYS=180
RETENTION_NOTIFICATIONS_DAYS=30
# Longest of the four: the only forensic record if an incident is reported late.
RETENTION_AUDIT_DAYS=365
RETENTION_REQUESTS_DAYS=180
RETENTION_SWEEP_INTERVAL_HOURS=24

# ─── Domain rules (tunable) ─────────────────────────────
MIN_DONOR_AGE=18
MAX_DONOR_AGE=65
MIN_DONOR_WEIGHT=50
COOLDOWN_DAYS_MALE=90
COOLDOWN_DAYS_FEMALE=120
EMERGENCY_RADIUS_KM=20
# Minutes an unaccepted critical request waits before its broadcast radius
# escalates one step (20 → 50 → 100 km)
ESCALATION_AFTER_MIN=15
# How often the request lifecycle worker (expiry + escalation) runs
WORKER_INTERVAL_SEC=60
